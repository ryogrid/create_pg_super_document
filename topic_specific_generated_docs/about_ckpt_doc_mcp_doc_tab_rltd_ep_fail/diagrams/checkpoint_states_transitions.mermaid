stateDiagram-v2
    [*] --> Idle: CheckpointerMain starts

    state Idle {
        [*] --> Sleeping: WaitLatch()
        Sleeping --> CheckFlags: Latch set or timeout
        CheckFlags --> Sleeping: No checkpoint needed
        CheckFlags --> ProcessSignals: Check interrupts
        ProcessSignals --> Sleeping: Continue normal operation
    }

    state "Checkpoint Request Evaluation" as Evaluation {
        [*] --> TimeCheck: Check elapsed time
        TimeCheck --> WALCheck: >= checkpoint_timeout?
        WALCheck --> FlagCheck: Check ckpt_flags
        FlagCheck --> DecisionMade: All triggers evaluated
    }

    state "Checkpoint Execution" as Execution {
        [*] --> ModeSelection
        ModeSelection --> RestartPoint: RecoveryInProgress() == true
        ModeSelection --> NormalCheckpoint: RecoveryInProgress() == false
        ModeSelection --> NormalCheckpoint: CHECKPOINT_END_OF_RECOVERY set

        state RestartPoint {
            [*] --> RestartPointExecution
            RestartPointExecution --> RestartPointComplete: CreateRestartPoint()
            RestartPointComplete --> [*]
        }

        state NormalCheckpoint {
            [*] --> CheckpointPrep
            CheckpointPrep --> CriticalSection: Setup checkpoint record
            CriticalSection --> RedoPoint: Establish REDO point
            RedoPoint --> BufferSync: CheckPointGuts()
            BufferSync --> WALRecord: All buffers flushed
            WALRecord --> ControlFile: Insert checkpoint record
            ControlFile --> CheckpointComplete: Update control file
            CheckpointComplete --> [*]
        }
    }

    state "Buffer States During Checkpoint" as BufferStates {
        [*] --> CleanBuffer
        CleanBuffer --> DirtyBuffer: Page modified
        DirtyBuffer --> CheckpointNeeded: BufferSync scan
        CheckpointNeeded --> IOInProgress: SyncOneBuffer()
        IOInProgress --> WritingToWAL: FlushBuffer() - XLogFlush()
        WritingToWAL --> WritingToData: WAL flushed, smgrwrite()
        WritingToData --> CleanBuffer: TerminateBufferIO()

        %% Race conditions and concurrent access
        IOInProgress --> IOInProgress: BM_JUST_DIRTIED set
        CheckpointNeeded --> CheckpointNeeded: Skipped by race condition
        DirtyBuffer --> DirtyBuffer: Additional modifications
    }

    state "Shared Memory State" as SharedMemState {
        [*] --> NoRequest
        NoRequest --> RequestPending: ckpt_flags set by backend
        RequestPending --> InProgress: ckpt_started incremented
        InProgress --> Completing: Checkpoint work done
        Completing --> NoRequest: ckpt_done = ckpt_started

        %% Error states
        InProgress --> Failed: Checkpoint error
        Failed --> NoRequest: ckpt_failed incremented
    }

    state "Process Coordination" as ProcessCoord {
        [*] --> BackendRequest
        BackendRequest --> CheckpointerWakeup: SetLatch()
        CheckpointerWakeup --> AcknowledgeRequest: Atomically fetch flags
        AcknowledgeRequest --> ExecuteWork: Increment ckpt_started
        ExecuteWork --> NotifyCompletion: Broadcast condition variable
        NotifyCompletion --> [*]
    }

    %% Main state transitions
    Idle --> Evaluation: Trigger detected
    Evaluation --> Execution: Checkpoint decided
    Evaluation --> Idle: No checkpoint needed
    Execution --> Idle: Checkpoint complete

    %% Error handling
    Execution --> ErrorRecovery: Exception occurred
    ErrorRecovery --> Idle: Error handled, cleanup done

    %% Special transitions
    Idle --> Shutdown: SIGUSR2 received
    Shutdown --> [*]: Process exit

    %% Archive timeout handling
    Idle --> ArchiveTimeout: XLogArchiveTimeout elapsed
    ArchiveTimeout --> Idle: WAL file switched

    %% Detailed state annotations
    note right of CheckFlags
        Atomic read of
        CheckpointerShmem->ckpt_flags
    end note

    note right of ModeSelection
        if (RecoveryInProgress() &&
            !(flags & CHECKPOINT_END_OF_RECOVERY))
            do restart point
        else
            do normal checkpoint
    end note

    note right of CriticalSection
        START_CRIT_SECTION()
        System panic if trouble
    end note

    note right of BufferSync
        1. Scan all buffers
        2. Mark BM_CHECKPOINT_NEEDED
        3. Sort by tablespace/relation
        4. Balanced write execution
    end note

    note right of IOInProgress
        BM_IO_IN_PROGRESS prevents
        concurrent writes to same buffer
    end note

    note right of RequestPending
        Backend calls RequestCheckpoint()
        Sets flags and wakes checkpointer
    end note