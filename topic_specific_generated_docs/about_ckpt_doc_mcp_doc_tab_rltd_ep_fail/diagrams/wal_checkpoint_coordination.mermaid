sequenceDiagram
    participant CP as CheckpointerMain
    participant CCF as CreateCheckPoint
    participant WAL as WAL Subsystem
    participant BM as Buffer Manager
    participant CF as Control File
    participant Storage as Disk Storage

    Note over CP,Storage: WAL-Checkpoint Coordination Timeline

    CP->>CCF: CreateCheckPoint(flags)
    Note over CCF: Begin checkpoint execution

    %% Phase 1: Pre-checkpoint WAL coordination
    CCF->>WAL: GetLastImportantRecPtr()
    WAL-->>CCF: last_important_lsn

    alt Skip checkpoint if idle
        CCF->>CCF: if (last_important_lsn == ControlFile->checkPoint)
        CCF->>CCF: Skip checkpoint - no WAL activity
        CCF-->>CP: return (checkpoint skipped)
    end

    %% Phase 2: Establish REDO point
    CCF->>WAL: WALInsertLockAcquireExclusive()
    Note right of WAL: Block concurrent WAL insertions

    alt Shutdown Checkpoint
        CCF->>WAL: Calculate new REDO point
        CCF->>WAL: Update RedoRecPtr = checkPoint.redo
        Note right of WAL: REDO point = next WAL record location
    else Online Checkpoint
        CCF->>WAL: WALInsertLockRelease()
        CCF->>WAL: XLogBeginInsert()
        CCF->>WAL: XLogRegisterData(&wal_level, sizeof(wal_level))
        CCF->>WAL: XLogInsert(RM_XLOG_ID, XLOG_CHECKPOINT_REDO)
        Note right of WAL: REDO record establishes checkpoint start
        WAL-->>CCF: REDO LSN returned
        CCF->>CCF: checkPoint.redo = RedoRecPtr
    end

    CCF->>WAL: Update XLogCtl->RedoRecPtr

    %% Phase 3: Transaction coordination
    CCF->>CCF: GetVirtualXIDsDelayingChkpt(&nvxids, DELAY_CHKPT_START)

    loop While transactions in commit critical sections
        CCF->>CCF: AbsorbSyncRequests()
        CCF->>CCF: pg_usleep(10000L) - wait 10ms
        CCF->>CCF: Check HaveVirtualXIDsDelayingChkpt()
    end

    %% Phase 4: Buffer flushing with WAL coordination
    CCF->>BM: CheckPointGuts(checkPoint.redo, flags)

    loop For each dirty buffer
        BM->>BM: Identify buffer LSN
        BM->>WAL: XLogFlush(buffer_lsn)
        Note right of WAL: WAL-before-data rule enforcement
        WAL->>Storage: Flush WAL records to disk
        Storage-->>WAL: WAL flush complete
        WAL-->>BM: WAL flushed confirmation
        BM->>Storage: Write buffer to disk
        Storage-->>BM: Buffer write complete
    end

    %% Phase 5: Final transaction coordination
    CCF->>CCF: GetVirtualXIDsDelayingChkpt(&nvxids, DELAY_CHKPT_COMPLETE)

    loop While transactions completing
        CCF->>CCF: AbsorbSyncRequests()
        CCF->>CCF: pg_usleep(10000L)
        CCF->>CCF: Check HaveVirtualXIDsDelayingChkpt()
    end

    %% Phase 6: Checkpoint record insertion
    alt Hot Standby active
        CCF->>WAL: LogStandbySnapshot()
        Note right of WAL: Record running transaction state
    end

    CCF->>WAL: START_CRIT_SECTION()
    CCF->>WAL: XLogBeginInsert()
    CCF->>WAL: XLogRegisterData(&checkPoint, sizeof(checkPoint))

    alt Shutdown checkpoint
        CCF->>WAL: XLogInsert(RM_XLOG_ID, XLOG_CHECKPOINT_SHUTDOWN)
    else Online checkpoint
        CCF->>WAL: XLogInsert(RM_XLOG_ID, XLOG_CHECKPOINT_ONLINE)
    end

    WAL-->>CCF: checkpoint_record_lsn
    CCF->>WAL: XLogFlush(checkpoint_record_lsn)
    WAL->>Storage: Flush checkpoint record
    Storage-->>WAL: Checkpoint record on disk
    WAL-->>CCF: Checkpoint record flushed

    %% Phase 7: Control file update
    CCF->>CF: LWLockAcquire(ControlFileLock, LW_EXCLUSIVE)
    CCF->>CF: ControlFile->checkPoint = ProcLastRecPtr
    CCF->>CF: ControlFile->checkPointCopy = checkPoint
    CCF->>CF: UpdateControlFile()

    CF->>CF: Update timestamp and CRC
    CF->>Storage: Write control file
    CF->>Storage: fsync control file
    Storage-->>CF: Control file persisted
    CF-->>CCF: Control file updated

    CCF->>CF: LWLockRelease(ControlFileLock)
    CCF->>WAL: END_CRIT_SECTION()

    %% Phase 8: Post-checkpoint WAL management
    CCF->>WAL: SetWalSummarizerLatch()
    Note right of WAL: Signal WAL summarizer for cleanup

    CCF->>WAL: XLByteToSeg(RedoRecPtr, &_logSegNo, wal_segment_size)
    CCF->>WAL: KeepLogSeg(recptr, slotsMinReqLSN, &_logSegNo)
    CCF->>WAL: RemoveOldXlogFiles(_logSegNo, RedoRecPtr, recptr, checkPoint.ThisTimeLineID)
    Note right of WAL: Clean up obsolete WAL files

    alt Normal operation
        CCF->>WAL: PreallocXlogFiles(recptr, checkPoint.ThisTimeLineID)
        Note right of WAL: Pre-create new WAL files
    end

    %% Phase 9: Final logging
    CCF->>WAL: LogCheckpointEnd(false)
    CCF-->>CP: CreateCheckPoint complete

    Note over CP,Storage: Key WAL Coordination Points
    Note over WAL: 1. REDO point establishment ensures recovery consistency
    Note over BM: 2. WAL-before-data rule prevents torn pages
    Note over CCF: 3. Transaction delays prevent commit race conditions
    Note over CF: 4. Control file update atomically commits checkpoint
    Note over WAL: 5. WAL cleanup maintains manageable log volume