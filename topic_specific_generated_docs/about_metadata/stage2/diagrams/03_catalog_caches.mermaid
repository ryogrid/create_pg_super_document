%% Catalog cache layering: relcache uses syscache uses catcache; pg_internal.init
%% provides a startup shortcut. Plancache and partcache sit beside relcache.

graph TB
    subgraph CALLERS["Catalog consumers"]
        PARSE[Parser / Analyzer]
        PLANNER[Planner]
        EXEC[Executor]
        DDL[DDL machinery]
    end

    PARSE --> RELOPEN
    PLANNER --> RELOPEN
    EXEC --> RELOPEN
    DDL --> RELOPEN

    subgraph RELCACHE["relcache (per-relation)"]
        RELOPEN["RelationIdGetRelation()<br/>relcache.c"]
        RELOPEN --> RHASH["RelationIdCache<br/>(htab on relid)"]
        RHASH -->|miss| RBD["RelationBuildDesc()<br/>relcache.c"]
        RBD --> SPR["ScanPgRelation()"]
        RBD --> RBTD["RelationBuildTupleDesc"]
    end

    subgraph SYSCACHE["syscache (per-row)"]
        SS1["SearchSysCache1..4()<br/>syscache.c"]
        SS1 --> CCINFO["cacheinfo[]<br/>(generated by genbki.pl)"]
    end

    SPR --> SS1
    RBTD --> SS1

    subgraph CATCACHE["catcache (low-level hashtab)"]
        SCC["SearchCatCacheInternal()<br/>catcache.c"]
        SCC --> BUCKETS["dlist of CatCTup<br/>per hash bucket"]
        SCC -->|miss| SCCM["SearchCatCacheMiss()<br/>catalog index scan"]
        SCC -->|negative miss| NEG["CT_NEGATIVE entry"]
    end

    SS1 --> SCC

    subgraph SHORTCUT["Startup shortcut"]
        PII["pg_internal.init<br/>per-database + global"]
        WRINIT["write_relcache_init_file"]
        LDINIT["load_relcache_init_file"]
    end

    RELCACHE --> WRINIT
    LDINIT --> RHASH

    subgraph SIDE["Auxiliary caches"]
        PLAN[plancache.c]
        PART[partcache.c]
        TYPE[typcache.c]
        EVT[evtcache.c]
        ATT[attoptcache.c]
        SPC[spccache.c]
        TS[ts_cache.c]
        RFNM[relfilenumbermap.c]
    end

    PLAN -.uses.-> RELCACHE
    PART -.uses.-> RELCACHE
    TYPE -.uses.-> SYSCACHE
